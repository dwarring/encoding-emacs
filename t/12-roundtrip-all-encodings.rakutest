use v6.d;
use Test;
use lib 'lib';

use Encoding::Emacs::MappingTable;

# Each tuple: (map-file-name, description, test-bytes-and-expected-chars)
# test-bytes format: Buf → expected Str (must be ASCII for simplicity)
my @all-maps = (
    # ISO-8859 family
    ('8859-2',    'ISO-8859-2'),
    ('8859-3',    'ISO-8859-3'),
    ('8859-4',    'ISO-8859-4'),
    ('8859-5',    'ISO-8859-5'),
    ('8859-6',    'ISO-8859-6'),
    ('8859-7',    'ISO-8859-7'),
    ('8859-8',    'ISO-8859-8'),
    ('8859-9',    'ISO-8859-9'),
    ('8859-14',   'ISO-8859-14'),
    ('8859-15',   'ISO-8859-15'),
    # Windows codepages
    ('CP1250',    'Windows-1250'),
    ('CP1251',    'Windows-1251'),
    ('CP1252',    'Windows-1252'),
    ('CP1253',    'Windows-1253'),
    ('CP1254',    'Windows-1254'),
    ('CP1255',    'Windows-1255'),
    ('CP1256',    'Windows-1256'),
    ('CP1257',    'Windows-1257'),
    ('CP1258',    'Windows-1258'),
    # DOS codepages
    ('IBM437',    'IBM-437'),
    ('IBM850',    'IBM-850'),
    ('IBM851',    'IBM-851'),
    ('IBM852',    'IBM-852'),
    ('IBM855',    'IBM-855'),
    ('IBM857',    'IBM-857'),
    ('IBM860',    'IBM-860'),
    ('IBM861',    'IBM-861'),
    ('IBM862',    'IBM-862'),
    ('IBM863',    'IBM-863'),
    ('IBM864',    'IBM-864'),
    ('IBM865',    'IBM-865'),
    ('IBM866',    'IBM-866'),
    ('IBM869',    'IBM-869'),
    ('IBM874',    'IBM-874'),
    ('CP720',     'CP-720'),
    ('CP737',     'CP-737'),
    ('CP775',     'CP-775'),
    ('CP858',     'CP-858'),
    ('CP1125',    'CP-1125'),
    # Russian/Cyrillic
    ('KOI8-R',    'KOI8-R'),
    ('KOI8-U',    'KOI8-U'),
    ('KOI8-T',    'KOI8-T'),
    ('ALTERNATIVNYJ', 'Alternativnyj'),
    ('MIK',       'MIK'),
    # Other
    ('MACINTOSH', 'Mac Roman'),
    ('HP-ROMAN8', 'HP Roman8'),
    ('NEXTSTEP',  'NeXTSTEP'),
    ('VISCII',    'VISCII'),
    ('VSCII',     'VSCII'),
    ('VSCII-2',   'VSCII-2'),
    ('KA-ACADEMY','Georgian Academy'),
    ('KA-PS',     'Georgian PS'),
    # JISX213A is a multi-byte supplement and not ASCII-compatible — excluded
);

plan @all-maps.elems * 3;

for @all-maps -> ($map-file, $description) {
    my $table;
    lives-ok {
        $table = load-mapping-table($map-file, 'emacs-src/charsets');
    }, "$description: mapping table loads without error";

    # ASCII round-trip (all these encodings are ASCII-compatible via identity offset 0)
    my $ascii-buf = Blob.new((0x41..0x5A).list);  # A-Z
    my $decoded = $table.decode-bytes($ascii-buf);
    is $decoded, 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
        "$description: A-Z ASCII decode identity";

    # Encode A-Z and verify bytes
    my $encoded = $table.encode-string('ABCDEFGHIJKLMNOPQRSTUVWXYZ');
    is $encoded.list.join(','), (0x41..0x5A).join(','),
        "$description: A-Z ASCII encode identity";
}

done-testing;
